# FinHelp Backend Environment Configuration
# Copy this file to .env and configure your variables

# Optional: Add your Google Gemini API key to enable live generative AI responses.
# If left empty, FinHelp runs automatically in smart rule-based advisor mode (no broken UI, full features).
GEMINI_API_KEY=

# AI Model to use
AI_MODEL=gemini-1.5-flash

# Database URL (Defaults to local SQLite finhelp.db)
DATABASE_URL=sqlite:///./finhelp.db
